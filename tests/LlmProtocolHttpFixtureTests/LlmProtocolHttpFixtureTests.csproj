<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <!-- Use the installed .NET 10 runtime when validating against RimWorld 1.7. -->
    <TargetFramework Condition="'$(RimWorld17Managed)'!=''">net10.0</TargetFramework>
    <AssemblyName>LlmProtocolHttpFixtureTests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RimWorldManaged Condition="'$(RimWorldManaged)'=='' and '$(RIMWORLD_MANAGED)'!=''">$(RIMWORLD_MANAGED)</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)'==''">D:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <!-- The linked runtime seam exists only in the mod's Debug build. Remove the caller's Release
       global when building this reference, then opt the dependency into Debug explicitly. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" Condition="'$(RimWorld17Managed)'==''" />
    <ProjectReference Include="..\..\Source\PawnDiary.csproj"
                      Condition="'$(RimWorld17Managed)'==''"
                      GlobalPropertiesToRemove="Configuration"
                      AdditionalProperties="Configuration=Debug;Platform=AnyCPU" />
    <ProjectReference Include="..\..\Source\PawnDiary.1.7.csproj"
                      Condition="'$(RimWorld17Managed)'!=''"
                      GlobalPropertiesToRemove="Configuration"
                      AdditionalProperties="Configuration=Debug;RimWorldManaged=$(RimWorld17Managed)" />
    <Reference Include="Assembly-CSharp">
      <HintPath Condition="'$(RimWorld17Managed)'==''">$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <HintPath Condition="'$(RimWorld17Managed)'!=''">$(RimWorld17Managed)\Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\Source\Libs\0Harmony.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityStubs" Condition="'$(RimWorld17Managed)'!=''">
      <HintPath>$(RimWorld17Managed)\UnityStubs.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="'$(RimWorld17Managed)'==''">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="'$(RimWorld17Managed)'==''">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="'$(RimWorld17Managed)'==''">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>
