<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- This focused link graph needs the routing contracts, but not the codecs that assign every DTO field. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Link only plain C# policy/state. Any RimWorld/Verse/Unity dependency fails this build. -->
  <ItemGroup>
    <Compile Include="..\..\Source\Pipeline\ApiEndpointPolicy.cs" Link="ApiEndpointPolicy.cs" />
    <Compile Include="..\..\Source\Pipeline\ModelReasoningCapability.cs" Link="ModelReasoningCapability.cs" />
    <Compile Include="..\..\Source\Pipeline\Transport\LlmProtocolContracts.cs" Link="LlmProtocolContracts.cs" />
    <Compile Include="..\..\Source\Pipeline\Transport\LlmProtocolDispatcher.cs" Link="LlmProtocolDispatcher.cs" />
    <Compile Include="..\..\Source\Settings\EndpointUtility.cs" Link="EndpointUtility.cs" />
    <Compile Include="..\..\Source\Diagnostics\Pure\ErrorReportSessionState.cs" Link="ErrorReportSessionState.cs" />
  </ItemGroup>
</Project>
