<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 ships .NET 10 and UnityStubs beside the executable. Keep the Mono
       project separate so rebuilding this version never overwrites the 1.6 assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PawnDiary</AssemblyName>
    <RootNamespace>PawnDiary</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldManaged Condition="'$(RimWorldManaged)'=='' and '$(RIMWORLD_MANAGED)'!=''">$(RIMWORLD_MANAGED)</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)'==''">$(MSBuildProjectDirectory)\..\..\..</RimWorldManaged>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldManaged)\UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="Libs\0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="StampVersionFromAbout" BeforeTargets="CoreCompile">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\About\About.xml" Query="/ModMetaData/modVersion/text()">
      <Output TaskParameter="Result" PropertyName="_ModVersion" />
    </XmlPeek>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute"><_Parameter1>$([System.Text.RegularExpressions.Regex]::Replace('$(_ModVersion)', '\.rc$', ''))</_Parameter1></AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute"><_Parameter1>$([System.Text.RegularExpressions.Regex]::Replace('$(_ModVersion)', '\.rc$', ''))</_Parameter1></AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute"><_Parameter1>$(_ModVersion)</_Parameter1></AssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(AssemblyAttribute)" Language="C#" OutputFile="$(IntermediateOutputPath)PawnDiaryVersion.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>
  <!-- XML remains authored in 1.6; refresh the versioned release copy on every build. -->
  <Target Name="SyncSharedContent" AfterTargets="Build">
    <ItemGroup>
      <_SharedDefs Include="..\1.6\Defs\**\*" />
      <_SharedPatches Include="..\1.6\Patches\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SharedDefs)" DestinationFiles="@(_SharedDefs->'..\1.7\Defs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SharedPatches)" DestinationFiles="@(_SharedPatches->'..\1.7\Patches\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
