<Project>
  <!-- Two runtimes compile the same source tree. Isolate NuGet assets and generated source
       before SDK imports run, so a 1.7 restore cannot poison the legacy 1.6 build. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <!-- Runtime DLLs are committed. Embedding the current Git SHA through Source Link would
         change their PDB checksum after every commit even when the source is identical. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>
